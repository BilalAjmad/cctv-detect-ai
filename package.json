{
  "name": "cctv-detect",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "postinstall": "node scripts/postinstall.cjs",
    "cap:add:android": "npx cap add android",
